<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_win_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You won!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/holo_green_dark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_completion_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Completion Time: 00:00"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/tv_win_message"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_next_game"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="8dp"
        android:text="Next Game"
        android:backgroundTint="@color/holo_blue_light"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/tv_completion_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_exit_game" />

    <Button
        android:id="@+id/btn_exit_game"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Exit"
        android:backgroundTint="@color/holo_red_light"
        android:textColor="@color/white"
        app:layout_constraintTop_toTopOf="@id/btn_next_game"
        app:layout_constraintBottom_toBottomOf="@id/btn_next_game"
        app:layout_constraintStart_toEndOf="@id/btn_next_game"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>